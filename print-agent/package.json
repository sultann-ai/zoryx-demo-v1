{
  "name": "zoryx-print-agent",
  "version": "1.0.0",
  "description": "Runs on the cashier PC. Connects out to the cloud backend over Socket.io and prints ESC/POS jobs on the physical thermal printer. Never deployed to Railway/Vercel.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test-print": "ts-node src/testPrint.ts"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.1",
    "node-thermal-printer": "^4.4.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
