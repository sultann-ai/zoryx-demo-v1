# The backend's URL (same one the frontend's VITE_API_URL points at), e.g.
# https://your-zoryx-api.up.railway.app or http://localhost:5000 for local dev.
BACKEND_URL=

# Must match the backend's PRINT_AGENT_KEY exactly.
PRINT_AGENT_KEY=

# Identifies this printer to the backend — only matters if you ever run more than one agent
# (e.g. a receipt printer and a kitchen printer). Matches VITE_PRINTER_ID on the frontend.
PRINTER_ID=main

# EPSON (default), STAR, or TANCA.
PRINTER_TYPE=EPSON

# One of:
#   printer:<exact Windows printer name>   e.g. printer:EPSON TM-T88V Receipt
#   tcp://<printer IP>:9100                 for a LAN/network printer
#   <COM port>                               e.g. COM3, for a Bluetooth-serial printer
#   preview                                  no real printer — logs to the console and writes
#                                             out/last-job.bin (the default, safe to leave as
#                                             -is until you're ready to point this at real
#                                             hardware)
PRINTER_INTERFACE=preview

# Characters per line: 48 for 80mm paper (default), 32 for 58mm paper.
PRINTER_WIDTH_CHARS=48

# node-thermal-printer character set name, e.g. PC437_USA (default), WPC1252, PC850_MULTILINGUAL.
PRINTER_CHARSET=PC437_USA

# Set to false to skip the cut command (e.g. if your printer has no cutter).
CUT_ENABLED=true

# Set to 1 to force preview-style rendering (console + out/last-job.bin) even if
# PRINTER_INTERFACE is set to something real — handy for testing without disconnecting the
# real printer.
DRY_RUN=
