# PostgreSQL connection string (used by Prisma)
DATABASE_URL=

# Secret used to sign/verify JWTs for staff and customer auth
JWT_SECRET=

# Port the Express server listens on — Railway sets this automatically in production,
# only needed for local dev
PORT=5000

# Comma-separated list of allowed frontend origins for CORS (HTTP + Socket.io), e.g.
# https://pos.example.com,https://kitchen.example.com
# MUST include the customer website's origin(s) too (https://www.example.com and the bare domain, plus any
# preview-deploy pattern such as https://site-*.vercel.app): guest checkout is a JSON POST from the website's
# browser, which sends a CORS preflight — without the origin listed here the browser blocks every order.
# Falls back to http://localhost:5173 (the Vite dev server) when unset
CORS_ORIGIN=

# Shared secret the print-agent process (print-agent/, runs on the cashier's PC, never
# deployed here) presents over its Socket.io handshake. Optional — if unset, every print-agent
# connection attempt is rejected, which is how printing-to-a-real-printer is disabled. Use a
# long random value (24+ characters; a shorter one logs a boot-time warning) and set the same
# value in print-agent/.env's PRINT_AGENT_KEY.
PRINT_AGENT_KEY=

# How many reverse proxies sit in front of the app. Railway's edge = 1 (the default). Used so
# per-IP rate limits see real visitors instead of the proxy. Add 1 for each extra proxy (e.g.
# Cloudflare in front of Railway = 2). Must be a non-negative integer.
TRUST_PROXY_HOPS=1

# Set to true to log req.ip and the raw X-Forwarded-For / X-Real-IP headers on every GET /health.
# Turn it on briefly after a deploy to confirm the logged IP is yours, then turn it off.
LOG_CLIENT_IP=false

# Password-based customer accounts (signup, login, saved addresses, JWT POST /api/online/orders).
# Default false: those routes answer 404 and the website uses guest checkout.
ENABLE_CUSTOMER_ACCOUNTS=false
