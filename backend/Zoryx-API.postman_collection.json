{
  "info": {
    "_postman_id": "b6f2a5b0-8f2a-4a1a-9b1a-zoryx-demo-api",
    "name": "Zoryx API",
    "description": "Full API for the Zoryx backend (POS + Online Ordering). Log in once using the 'Staff Login' request (sets {{token}} automatically) and/or the 'Customer Login' request (sets {{customerToken}} automatically), then run any other request in the collection. Replace :id / :itemId / :orderId path variables with real IDs from your own data (create a Kitchen, Category, MenuItem etc. first, or use IDs returned by earlier requests).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root health check",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "POS health check",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/pos/health" }
        },
        {
          "name": "Online health check",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/online/health" }
        }
      ]
    },
    {
      "name": "Auth (Staff)",
      "item": [
        {
          "name": "Staff Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    console.log('Saved staff token to {{token}}');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/pos/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"test.superadmin\",\n  \"password\": \"test-password-123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Business Day",
      "item": [
        { "name": "Get current business day", "request": { "method": "GET", "url": "{{baseUrl}}/api/pos/business-day/current" } },
        {
          "name": "Start business day",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/pos/business-day/start",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"2026-09-20\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "End business day",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/pos/business-day/end",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"force\": false\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
