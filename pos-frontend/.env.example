VITE_API_URL=http://localhost:5000

# Identifies which print agent "Print receipt"/"Print kitchen tickets" dispatch to. Matches
# PRINTER_ID in print-agent/.env. Falls back to "main" when unset.
VITE_PRINTER_ID=main

# The customer website (Online store -> "Open customer website" button). Leave empty to hide the button.
VITE_ONLINE_SITE_URL=
